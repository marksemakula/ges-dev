{
  "version": 3,
  "overrides": {
    "institutions/gjs-kampala/index.html": {
      "path": "institutions/gjs-kampala"
    },
    "institutions/gjs-gulu/index.html": {
      "path": "institutions/gjs-gulu"
    },
    "institutions/sisu-kampala/index.html": {
      "path": "institutions/sisu-kampala"
    },
    "institutions/sakghs-bujuuko/index.html": {
      "path": "institutions/sakghs-bujuuko"
    },
    "institutions/sisu-gulu/index.html": {
      "path": "institutions/sisu-gulu"
    },
    "institutions/sakghs-kawaala/index.html": {
      "path": "institutions/sakghs-kawaala"
    }
  },
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "status": 301,
      "headers": {
        "Location": "/institutions/gjs-kampala"
      },
      "src": "/institutions/gjs-kikajjo"
    },
    {
      "status": 301,
      "headers": {
        "Location": "/institutions/gjs-kampala"
      },
      "src": "/institutions/gjs-boarding"
    },
    {
      "status": 301,
      "headers": {
        "Location": "/institutions/gjs-gulu"
      },
      "src": "/institutions/gjs-about"
    },
    {
      "status": 301,
      "headers": {
        "Location": "/institutions/sisu-kampala"
      },
      "src": "/institutions/scooby-katale"
    },
    {
      "status": 301,
      "headers": {
        "Location": "/institutions/sisu-gulu"
      },
      "src": "/institutions/scooby-gulu"
    },
    {
      "status": 301,
      "headers": {
        "Location": "/international-pathway"
      },
      "src": "/institutions/iepp"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "X-Robots-Tag": "noindex"
      },
      "src": "/_nuxt"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable",
        "X-Robots-Tag": "noindex"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}