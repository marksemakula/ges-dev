# Legacy institution slugs — 301 to the landing pages on ges.ac.ug.
# (Only used by Netlify; Vercel gets the same rules from nuxt.config routeRules.)
# The trailing "!" forces the redirect even if a prerendered stub exists.
/institutions/gjs-kikajjo     /institutions/gjs-kampala   301!
/institutions/gjs-boarding    /institutions/gjs-kampala   301!
/institutions/gjs-about       /institutions/gjs-gulu      301!
/institutions/scooby-katale   /institutions/sisu-kampala  301!
/institutions/scooby-gulu     /institutions/sisu-gulu     301!
/institutions/iepp            /international-pathway      301!

# NOTE: intentionally NO "/* /index.html 200" SPA catch-all.
# Nuxt prerenders every page and emits 404.html, so Netlify serves the real
# pages and a proper 404 status (not a soft redirect to the homepage).
